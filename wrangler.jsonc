// Cloudflare Workers settings.
// Build with `python build_site.py`, then deploy with `npx wrangler deploy`.
// Pages are served straight from site/. Only /api/* (admin sign-in) runs worker.js.
{
  "name": "nocodesquare",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Keep anything set in the Cloudflare dashboard (e.g. sign-in secret) when the site redeploys
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // From the GitHub OAuth App (public, safe to keep here). The matching secret,
    // GITHUB_CLIENT_SECRET, is set in Cloudflare: Worker > Settings > Variables and Secrets.
    "GITHUB_CLIENT_ID": "Ov23lizTXiCixGMNrPXU"
  }
}
